# Copy this file to ".env" and fill in real values before running the server.
# Never commit your real ".env" file to git.

# Port the server listens on (most hosts like Render/Railway set this automatically)
PORT=3000

# Secret key required to access admin endpoints (view results, export CSV, delete entries).
# Pick a long random string. Example generator: https://1password.com/password-generator/
ADMIN_KEY=change-this-to-a-long-random-secret

# Comma-separated list of frontend origins allowed to call this API.
# Use "*" only for local testing — lock this down before going live.
# Example: https://your-ieee-site.netlify.app,https://your-ieee-site.vercel.app
ALLOWED_ORIGINS=*
